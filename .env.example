# Session signing secret. REQUIRED in production (fail-closed boot if missing).
# Generate with: openssl rand -base64 48
ANCLORA_GROUP_SESSION_SECRET=<generate-a-long-random-secret>

# Bootstrap user (used only when ANCLORA_GROUP_INTERNAL_USERS_JSON is empty).
# Passwords are bcrypt hashes, never plaintext. Generate a hash with:
#   node scripts/hash-password.mjs "<password>"
ANCLORA_GROUP_BOOTSTRAP_USERNAME=
ANCLORA_GROUP_BOOTSTRAP_PASSWORD_HASH=<bcrypt-hash>
ANCLORA_GROUP_BOOTSTRAP_DISPLAY_NAME=Administrador de Anclora Group
ANCLORA_GROUP_BOOTSTRAP_ROLE=group-admin

# Internal users as JSON array. passwordHash is a bcrypt hash.
# Format:
# [
#   {
#     "username": "example",
#     "passwordHash": "<bcrypt-hash>",
#     "displayName": "Example User",
#     "role": "group-admin"
#   }
# ]
# Valid roles: group-admin, private-estates-ops, partner-ops, data-ops,
# content-ops, advisory, growth-ops
# NOTE (local dev only): Next.js applies dotenv expansion to env values, so
# bcrypt hashes ($2b$...) get mangled when placed in a local .env file or
# shell env loaded by Next. Locally, escape dollars (\$) or pass the JSON via
# a mechanism that preserves it. Vercel dashboard env vars are NOT expanded
# and are safe as-is.
ANCLORA_GROUP_INTERNAL_USERS_JSON=

# Development-only legacy fallback (ignored in production):
# ANCLORA_GROUP_BOOTSTRAP_PASSWORD=   # plaintext, local DX only

NEXT_PUBLIC_GROUP_DEFAULT_LOCALE=es
# REMOVED in Phase 3: NEXT_PUBLIC_GROUP_DEFAULT_THEME — the portal is
# dark-only; the broken light theme was removed (no toggle ever shipped).

NEXT_PUBLIC_PRIVATE_ESTATES_URL=https://anclora-private-estates.vercel.app/
NEXT_PUBLIC_PRIVATE_ESTATES_LANDING_URL=https://anclora-private-estates-landing.vercel.app/
NEXT_PUBLIC_SYNERGI_INTERNAL_URL=https://anclora-synergi.vercel.app/partner-admissions/login
NEXT_PUBLIC_DATA_LAB_INTERNAL_URL=https://anclora-data-lab.vercel.app/access-requests/login
NEXT_PUBLIC_NEXUS_URL=https://anclora-nexus-frontend.vercel.app/
NEXT_PUBLIC_CONTENT_GENERATOR_AI_URL=https://anclora-content-generator-ai.vercel.app/
NEXT_PUBLIC_ADVISOR_AI_URL=https://ancloraadvisorai-ten.vercel.app/
NEXT_PUBLIC_IMPULSO_URL=https://anclora-impulso.vercel.app/
NEXT_PUBLIC_COMMAND_CENTER_URL=https://boveda-anclora.vercel.app/
NEXT_PUBLIC_FISCAL_URL=https://anclora-fiscal.vercel.app/
NEXT_PUBLIC_SYNCXML_URL=https://anclora-syncxml.vercel.app/
NEXT_PUBLIC_ENERGYSCAN_URL=https://anclora-energyscan.vercel.app/
